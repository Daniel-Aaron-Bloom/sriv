#!/usr/bin/env xdg-open
[Desktop Entry]
Version=1.0
Name=Simple Rust Image Viewer
GenericName=Image viewer
Comment=Image viewer
Exec=sriv %f
Terminal=false
Type=Application
Icon=sriv
StartupWMClass=sriv
Categories=Graphics;2DGraphics;Viewer;
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/pjpeg;image/png;image/tiff;image/webp;image/x-bmp;image/x-pcx;image/x-png;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-tga;image/x-xbitmap;image/heic;image/heif;image/hif;image/avif;image/svg+xml;
