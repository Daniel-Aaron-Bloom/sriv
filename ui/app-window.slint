export component AppWindow inherits Window {
    callback pointer-event(PointerEvent);
    callback scroll-event(PointerScrollEvent) -> EventResult;
    callback rotate(int);
    callback close-requested();
    pure callback get_width() -> length;
    pure callback get_height() -> length;
    in property <bool> entered;
    in property <bool> focused;
    in property <bool> dragged;
    in property <image> picture;
    // Non-empty shows a dismissible error bar at the bottom of the window.
    in-out property <string> error-text;

    no-frame: true;
    title: "sriv";
    icon: @image-url("icon.png");
    preferred-width: get_width();
    preferred-height: get_height();

    image := Image {
        width: parent.width - 2px;
        height: parent.height - 2px;
        x: 1px;
        y: 1px;
        z: 1.0;
        source: root.picture;
    }
    forward-focus: fs;
    fs := FocusScope {
        KeyBinding {
            keys: @keys(LeftArrow);
            activated => { root.rotate(-1); }
        }
        KeyBinding {
            keys: @keys(RightArrow);
            activated => { root.rotate(1); }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => { root.close-requested(); }
        }
    }
    ta := TouchArea {
        forward-focus: fs;
        pointer-event(e) => { root.pointer-event(e); }
        scroll-event(e) => { root.scroll-event(e) }
    }

    Rectangle {
        z: 0.0;
        states [
            focus-hover when root.focused && root.entered: {
                background: #60856823;
            }
            focus when root.dragged: {
                background: #67609223;
            }
            hover when !root.focused && root.entered: {
                background: #a7727223;
            }
            default when true: {
                background: transparent;
            }
        ]
    }

    background: transparent;

    // Error bar: visible while error-text is non-empty; click anywhere on it
    // to dismiss. Sits above the picture (z: 2.0) so it stays readable.
    if root.error-text != "": Rectangle {
        z: 2.0;
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: 30px;
        background: #8e2f24e6;
        Text {
            x: 10px;
            width: parent.width - 36px;
            height: parent.height;
            text: root.error-text;
            color: #ffe4de;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            x: parent.width - self.width - 10px;
            height: parent.height;
            text: "✕";
            color: #ffe4de;
            font-size: 12px;
            vertical-alignment: center;
        }
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.error-text = ""; }
        }
    }
}
